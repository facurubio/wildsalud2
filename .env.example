# Copiá este archivo como .env.local y completá los valores del proyecto de Supabase.
# .env.local nunca se sube a GitHub.

# Supabase → Project Settings → API (son públicas: van al navegador).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase → botón "Connect" → Transaction pooler (puerto 6543). Es SECRETA: solo el servidor la usa.
DATABASE_URL=postgresql://postgres.<ref>:<contraseña>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
